{
  "name": "qt6renderer",
  "displayName": "Qt6Renderer",
  "description": "Extension for pretty printing Qt types by GDB and LLDB",
  "publisher": "knv",
  "repository": "https://github.com/winseros/Qt6RendererVsc",
  "version": "0.4.0",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.106.1"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.py",
    "icon.png",
    "screenshots/*",
    "LICENSE.txt"
  ],
  "categories": [
    "Debuggers",
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onDebugResolve:cppdbg",
    "onDebugResolve:lldb-dap"
  ],
  "main": "dist/extension.js",
  "contributes": {},
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "lint": "prettier -c ./src && eslint ./src",
    "lint:fix": "prettier -w ./src && eslint --fix ./src"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/vscode": "^1.106.1",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "copy-webpack-plugin": "^13.0.1",
    "eslint": "^9.39.1",
    "prettier": "^3.7.3",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "webpack": "^5.103.0",
    "webpack-cli": "^6.0.1"
  }
}
